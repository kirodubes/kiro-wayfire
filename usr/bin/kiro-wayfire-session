#!/bin/sh
#####################################################################
# Author    : Erik Dubois
# Website   : https://kiroproject.be
#####################################################################
#   DO NOT JUST RUN THIS. EXAMINE AND JUDGE. RUN AT YOUR OWN RISK.
#
# Purpose:
#   Session entrypoint for the Kiro Wayfire edition, invoked by kiro-wayfire.desktop. Exports the Qt
#   variables the session needs, then starts wayfire (which reads ~/.config/wayfire.ini as before).
# Why:
#   wayfire.ini can't set environment variables, and /etc/environment holds only EDITOR on the Wayland
#   ISOs (GTK_THEME/BROWSER there broke GTK 4 and xdg-settings). Qt apps need QT_QPA_PLATFORMTHEME=gtk3
#   (tray icons, file dialogs) and QT_STYLE_OVERRIDE=kvantum (the KvGnomeDark look kiro-kvantum-default
#   sets) — the other editions export them from their compositor config.
#####################################################################

export QT_QPA_PLATFORMTHEME=gtk3
export QT_STYLE_OVERRIDE=kvantum

exec wayfire "$@"
